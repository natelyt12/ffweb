{
    "Image compress": {
        "cmd": "-q:v 5",
        "ext": ".jpg"
    },
    "Universal Video (Max Compatibility & Quality)": {
        "cmd": "-c:v libx264 -crf 18 -preset slow -pix_fmt yuv420p -profile:v high -level 4.1 -movflags +faststart -c:a aac -b:a 256k",
        "ext": ".mp4"
    },
    "Max Compression (H.265 HEVC)": {
        "cmd": "-c:v libx265 -crf 24 -preset medium -tag:v hvc1 -pix_fmt yuv420p -movflags +faststart -c:a aac -b:a 128k",
        "ext": ".mp4"
    },
    "Extract MP3 Audio (320kbps Best Quality)": {
        "cmd": "-vn -c:a libmp3lame -b:a 320k",
        "ext": ".mp3"
    },
    "Extract MP3 Audio (VBR High Quality)": {
        "cmd": "-vn -c:a libmp3lame -q:a 2",
        "ext": ".mp3"
    }
}